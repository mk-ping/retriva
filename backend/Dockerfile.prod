FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    tesseract-ocr \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 app

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=app:app app/ .
RUN mkdir -p /app/storage /home/app/.cache/chroma && chown -R app:app /app /home/app

USER app
ENV HOME=/home/app
EXPOSE 8000

# one worker on purpose: Chroma and the in-memory rate limiter are not safe across several workers
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'"]